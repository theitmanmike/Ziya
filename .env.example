# Supabase — Dashboard: https://supabase.com/dashboard/project/piuhezrgmoheoaosgmot
# Settings -> API sayfasından alınır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca sunucu tarafında kullanılır (RLS'yi bypass eder). ASLA client
# koduna veya NEXT_PUBLIC_ önekiyle EXPOSE ETMEYİN.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL (metadata, canonical linkler, OG image için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Faz 5: Gerçek veri entegrasyonu ---
# platform.openai.com/api-keys — embedding üretimi (match_events)
OPENAI_API_KEY=
# finnhub.io/dashboard — piyasa verisi (ve /company-news ile haber)
FINNHUB_API_KEY=
# alphavantage.co/support/#api-key — yedek piyasa verisi (günde 25 çağrı ile sınırlı)
ALPHA_VANTAGE_API_KEY=
# newsapi.org — yalnızca geliştirme ortamında kullanılabilir, prod için ücretli plan gerekir
NEWSAPI_API_KEY=
# gnews.io — günde 100 istek
GNEWS_API_KEY=
# open-platform.theguardian.com/access — pratikte sınırsız
GUARDIAN_API_KEY=
# marketaux.com — finans odaklı haber, ayda 100 istek
MARKETAUX_API_TOKEN=
# currentsapi.services — günde 600 istek
CURRENTS_API_KEY=
